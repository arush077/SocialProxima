# Connection string for MongoDB (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/socialproxima

# Port the API listens on (Render sets this automatically)
PORT=3000

# Secret used to sign JWTs - use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed frontend origins for CORS / Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# How recent a user must be to appear in discovery (ms). Default 24h.
ACTIVE_WINDOW_MS=86400000
